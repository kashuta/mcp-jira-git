# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ
JIRA_UPDATE_STATUS="In Progress"  # Status must exist in your Jira workflow

# Git Configuration
GIT_REPO_PATH=/absolute/path/to/your/repository  # Must be absolute path
GIT_DEFAULT_BRANCH=main  # Or your default branch name (e.g., master, develop)

# Debug Configuration (Optional)
# DEBUG=1                 # Set to 1 to enable debug mode
# LOG_LEVEL=info          # Options: debug, info, warn, error
